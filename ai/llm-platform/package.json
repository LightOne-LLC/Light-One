    "execute-task": "tsx llm/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
