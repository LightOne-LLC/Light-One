{
  "name": "light-one-llm-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Light One's shared LLM Router + Local Model foundation (llm/) and its first domain model (models/ses).",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
